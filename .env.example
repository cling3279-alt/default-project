# ==========================================================================
# Environment Configuration Example
# Copy this file to ".env" and fill in your values. Never commit ".env".
# ==========================================================================

# --- Application ---
# Environment: development | test | production
NODE_ENV=development

# Port for the Vite development server
VITE_PORT=5173

# Public base path of the deployed application (e.g. "/" or "/my-game/")
VITE_BASE_URL=/

# --- API / Backend (optional) ---
# URL of the game backend / API server, if any
VITE_API_URL=http://localhost:8000

# --- Game Settings ---
# Canvas / screen width and height in pixels
GAME_CANVAS_WIDTH=1280
GAME_CANVAS_HEIGHT=720

# Target frames per second of the game loop
GAME_FPS=60

# --- Logging ---
# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Python (tests / automation) ---
# Marker so scripts know a virtualenv should be used
PYTHON_ENV=venv